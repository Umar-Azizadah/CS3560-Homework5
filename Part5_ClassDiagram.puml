@startuml
'https://plantuml.com/class-diagram

class Folder {
    - name : String
    - subFolders : ArrayList<Folder>
    - files : ArrayList<File>

    + Folder(name : String)

    + getName() : String
    + getFiles() : ArrayList<File>
    + getSubFolders() : ArrayList<Folder>

    + setName(name : String) : void

    + addSubFolder(subFolder : Folder) : void
    + addFile(file : File) : void
    + removeSubFolder(subFolder : Folder) : void

    + print() : void
    + print(depth : int) : void
}

class File {
    - name : String

    + File(name : String)

    + getName() : String
    + setName(name : String) : void
    + print() : void
}

Folder "1" *-- "0..*" File
Folder "1" *-- "0..*" Folder : subFolders

@enduml